# The dev channel's names: an app of its own beside the stable one, with its own data, sign-ins, install and update
# feed. Read as stable.env is. A value holds no `'`.
CHANNEL_ID=chatkord-dev
CHANNEL_PRODUCT='Chatkord Dev'
CHANNEL_FILE=Chatkord-Dev
CHANNEL_APP_USER_MODEL_ID=Chatkord.ChatkordDev
# Windows' identity of the install: never changed, or a setup no longer replaces the install it should.
CHANNEL_SETUP_ID={3F5BF250-60ED-40BD-8749-E0537767BE69}
CHANNEL_UPDATE_KEY=dev.pub
CHANNEL_FEED=releases/download/dev/
