From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chatkord <chatkord@example.invalid>
Subject: [PATCH 5/5] avcodec/vaapi_encode: send a changed bitrate without a
 keyframe

The rate control and HRD parameters were sent only with an IDR picture,
so a change of bit_rate, rc_max_rate or rc_buffer_size made later on the
codec context took effect only at the next keyframe. A change is now
derived as at init and sent with the next picture of any type, as the
driver takes a rate control buffer at any picture; later IDR pictures
send the parameters in effect.
---
--- a/libavcodec/vaapi_encode.c
+++ b/libavcodec/vaapi_encode.c
@@ -265,6 +265,62 @@
     return 0;
 }
 
+/* Rates the codec context changed since the last picture, derived as
+ * vaapi_encode_init_rate_control() derives them, into the parameters every
+ * later picture is sent with; returns whether they changed. */
+static int vaapi_encode_update_rate_control(AVCodecContext *avctx)
+{
+    VAAPIEncodeContext *ctx = avctx->priv_data;
+    const VAAPIEncodeRCMode *rc_mode = ctx->rc_mode;
+    int64_t bits_per_second, buffer_size = 0, fullness = 0;
+    int target_percentage;
+
+    if (!rc_mode->bitrate || rc_mode->mode == RC_MODE_AVBR || avctx->bit_rate <= 0 ||
+        (avctx->bit_rate == ctx->rc_asked_bit_rate &&
+         avctx->rc_max_rate == ctx->rc_asked_max_rate &&
+         avctx->rc_buffer_size == ctx->rc_asked_buffer_size))
+        return 0;
+    ctx->rc_asked_bit_rate    = avctx->bit_rate;
+    ctx->rc_asked_max_rate    = avctx->rc_max_rate;
+    ctx->rc_asked_buffer_size = avctx->rc_buffer_size;
+
+    if (rc_mode->maxrate && avctx->rc_max_rate > 0) {
+        bits_per_second   = avctx->rc_max_rate;
+        target_percentage = avctx->bit_rate * 100 / avctx->rc_max_rate;
+    } else if (rc_mode->maxrate) {
+        bits_per_second   = 2 * avctx->bit_rate;
+        target_percentage = 50;
+    } else {
+        bits_per_second   = avctx->bit_rate;
+        target_percentage = 100;
+    }
+    if (rc_mode->hrd) {
+        buffer_size = avctx->rc_buffer_size ? avctx->rc_buffer_size :
+                      avctx->rc_max_rate > 0 ? avctx->rc_max_rate : avctx->bit_rate;
+        fullness = avctx->rc_initial_buffer_occupancy ?
+                   FFMIN(avctx->rc_initial_buffer_occupancy, buffer_size) :
+                   buffer_size * 3 / 4;
+    }
+    if (target_percentage > 100 || bits_per_second > UINT32_MAX ||
+        buffer_size > UINT32_MAX) {
+        av_log(avctx, AV_LOG_WARNING, "New rate (%"PRId64" bps, maxrate "
+               "%"PRId64") ignored: not valid in %s RC mode.\n",
+               avctx->bit_rate, avctx->rc_max_rate, rc_mode->name);
+        return 0;
+    }
+
+    ctx->rc_params.bits_per_second   = bits_per_second;
+    ctx->rc_params.target_percentage = target_percentage;
+    if (rc_mode->hrd) {
+        ctx->rc_params.window_size              = buffer_size * 1000 / bits_per_second;
+        ctx->hrd_params.buffer_size             = buffer_size;
+        ctx->hrd_params.initial_buffer_fullness = fullness;
+    }
+    av_log(avctx, AV_LOG_VERBOSE, "RC target: %d%% of %"PRId64" bps from "
+           "this picture on.\n", target_percentage, bits_per_second);
+    return 1;
+}
+
 static int vaapi_encode_issue(AVCodecContext *avctx,
                               FFHWBaseEncodePicture *base_pic)
 {
@@ -273,7 +329,7 @@
     VAAPIEncodePicture         *pic = base_pic->priv;
     VAAPIEncodeSlice *slice;
     VAStatus vas;
-    int err = 0, i;
+    int err = 0, i, rc_changed;
     char data[MAX_PARAM_BUFFER_SIZE];
     size_t bit_len;
     av_unused AVFrameSideData *sd;
@@ -346,12 +402,28 @@
             goto fail;
     }
 
+    rc_changed = vaapi_encode_update_rate_control(avctx);
     if (base_pic->type == FF_HW_PICTURE_TYPE_IDR) {
         for (i = 0; i < ctx->nb_global_params; i++) {
             err = vaapi_encode_make_misc_param_buffer(avctx, pic,
                                                       ctx->global_params_type[i],
                                                       ctx->global_params[i],
                                                       ctx->global_params_size[i]);
+            if (err < 0)
+                goto fail;
+        }
+    } else if (rc_changed) {
+        err = vaapi_encode_make_misc_param_buffer(avctx, pic,
+                                                  VAEncMiscParameterTypeRateControl,
+                                                  &ctx->rc_params,
+                                                  sizeof(ctx->rc_params));
+        if (err < 0)
+            goto fail;
+        if (ctx->rc_mode->hrd) {
+            err = vaapi_encode_make_misc_param_buffer(avctx, pic,
+                                                      VAEncMiscParameterTypeHRD,
+                                                      &ctx->hrd_params,
+                                                      sizeof(ctx->hrd_params));
             if (err < 0)
                 goto fail;
         }
@@ -1480,6 +1552,9 @@
     ctx->rc_quality  = rc_quality;
     ctx->va_rc_mode  = rc_mode->va_mode;
     ctx->va_bit_rate = rc_bits_per_second;
+    ctx->rc_asked_bit_rate    = avctx->bit_rate;
+    ctx->rc_asked_max_rate    = avctx->rc_max_rate;
+    ctx->rc_asked_buffer_size = avctx->rc_buffer_size;
 
     av_log(avctx, AV_LOG_VERBOSE, "RC mode: %s.\n", rc_mode->name);
 
--- a/libavcodec/vaapi_encode.h
+++ b/libavcodec/vaapi_encode.h
@@ -210,6 +210,11 @@
     // Rate control parameters.
     VAEncMiscParameterRateControl rc_params;
     VAEncMiscParameterHRD        hrd_params;
+    // The rates last asked of the codec context: a change between pictures
+    // is sent with the next picture, without a keyframe.
+    int64_t         rc_asked_bit_rate;
+    int64_t         rc_asked_max_rate;
+    int64_t         rc_asked_buffer_size;
     VAEncMiscParameterFrameRate   fr_params;
     VAEncMiscParameterBufferMaxFrameSize mfs_params;
 #if VA_CHECK_VERSION(0, 36, 0)
