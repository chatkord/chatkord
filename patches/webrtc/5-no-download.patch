+
+/// The engine's directory: the one `scripts/deps/webrtc.sh` unpacked, named by `LK_CUSTOM_WEBRTC`.
+fn webrtc_dir() -> PathBuf {
+    match env::var_os("LK_CUSTOM_WEBRTC") {
+        Some(dir) => PathBuf::from(dir),
+        None => panic!("The engine is not unpacked: run scripts/deps/webrtc.sh."),
+    }
+}
+
+/// The target system as the engine's release names it.
+fn target_os_name() -> String {
+    let target_os = env::var("CARGO_CFG_TARGET_OS").unwrap();
+    let simulator = env::var("TARGET").unwrap().ends_with("-sim");
+    match target_os.as_str() {
+        "windows" => "win",
+        "macos" => "mac",
+        "ios" if simulator => "ios-simulator",
+        "ios" => "ios-device",
+        _ => &target_os,
+    }
+    .to_string()
+}
+
+/// The target architecture as the engine's release names it.
+fn target_arch_name() -> String {
+    let target_arch = env::var("CARGO_CFG_TARGET_ARCH").unwrap();
+    match target_arch.as_str() {
+        "aarch64" => "arm64",
+        "x86_64" => "x64",
+        _ => &target_arch,
+    }
+    .to_owned()
+}
+
+/// The preprocessor definitions the engine was built with, from the first line of its ninja files.
+fn webrtc_defines() -> Vec<(String, Option<String>)> {
+    let mut seen = HashSet::new();
+    let mut defines = Vec::new();
+    for file in ["webrtc.ninja", "desktop_capture.ninja"] {
+        let path = webrtc_dir().join(file);
+        let ninja = fs::File::open(&path).unwrap_or_else(|e| panic!("Could not open ninja file: {path:?}\n{e:?}"));
+        let mut line = String::new();
+        io::BufReader::new(ninja).read_line(&mut line).unwrap();
+        for token in line.split_whitespace().filter_map(|token| token.strip_prefix("-D")) {
+            let (name, value) = match token.split_once('=') {
+                Some((name, value)) => (name, Some(value.to_string())),
+                None => (token, None),
+            };
+            if matches!(name, "CR_CLANG_REVISION" | "CR_XCODE_VERSION") || name.is_empty() {
+                continue;
+            }
+            if seen.insert((name.to_string(), value.clone())) {
+                defines.push((name.to_string(), value));
+            }
+        }
+    }
+    defines
+}
