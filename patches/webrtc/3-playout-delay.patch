From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chatkord <noreply@example.invalid>
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH] playout-delay: the synthetic audio device reports the
 speaker's delay

The synthetic audio device answered the engine's PlayoutDelay with 0. libwebrtc's audio and
video sync adds that delay to a sound's delay (ChannelReceive::GetSyncInfo).
Measured: with a speaker 150 ms late, the picture is held 140 ms longer once the sync has
settled (it moves some ten ms a second), so a watched screen keeps to its sound.

The host sets the delay its chain's speaker measures.

diff --git a/libwebrtc/src/native/peer_connection_factory.rs b/libwebrtc/src/native/peer_connection_factory.rs
index 422ea00..3b64f97 100644
--- a/libwebrtc/src/native/peer_connection_factory.rs
+++ b/libwebrtc/src/native/peer_connection_factory.rs
@@ -369,6 +369,12 @@ impl PeerConnectionFactory {
         self.sys_handle.audio_device().platform_adm_ref_count()
     }
 
+    /// Added by Chatkord (patches/webrtc): how long the host's own speaker takes to play what the synthetic device
+    /// hands it, which the engine's audio and video sync counts in the sound's delay.
+    pub fn set_playout_delay_ms(&self, delay_ms: u16) {
+        self.sys_handle.audio_device().set_playout_delay_ms(delay_ms)
+    }
+
     /// Returns true if Platform ADM is currently active (ref_count > 0).
     pub fn is_platform_adm_active(&self) -> bool {
         self.sys_handle.audio_device().is_platform_adm_active()
diff --git a/libwebrtc/src/peer_connection_factory.rs b/libwebrtc/src/peer_connection_factory.rs
index 8e50457..c4ff703 100644
--- a/libwebrtc/src/peer_connection_factory.rs
+++ b/libwebrtc/src/peer_connection_factory.rs
@@ -286,6 +286,9 @@ pub mod native {
         fn release_platform_adm(&self);
         fn platform_adm_ref_count(&self) -> i32;
         fn is_platform_adm_active(&self) -> bool;
+        /// Added by Chatkord (patches/webrtc): how long the host's own speaker takes to play what the engine hands
+        /// it, counted in the sound's delay by the engine's audio and video sync.
+        fn set_playout_delay_ms(&self, delay_ms: u16);
     }
 
     impl PeerConnectionFactoryExt for PeerConnectionFactory {
@@ -428,5 +431,9 @@ pub mod native {
         fn is_platform_adm_active(&self) -> bool {
             self.handle.is_platform_adm_active()
         }
+
+        fn set_playout_delay_ms(&self, delay_ms: u16) {
+            self.handle.set_playout_delay_ms(delay_ms)
+        }
     }
 }
diff --git a/webrtc-sys/include/livekit/adm_proxy.h b/webrtc-sys/include/livekit/adm_proxy.h
