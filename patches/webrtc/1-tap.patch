diff --git a/webrtc-sys/include/livekit/encoded_frame_tap.h b/webrtc-sys/include/livekit/encoded_frame_tap.h
new file mode 100644
index 0000000..5664e6b
--- /dev/null
+++ b/webrtc-sys/include/livekit/encoded_frame_tap.h
@@ -0,0 +1,50 @@
+/*
+ * Hands the encoded video frames of a remote track to the host as the engine's frame buffer releases them.
+ *
+ * Added by Chatkord (patches/webrtc): the pinned crate has no way to read a received frame's bytes
+ * or to decode them elsewhere. The engine's encoded sink hands over each frame it would decode, in
+ * decode order and never past a lost reference, so its feedback, jitter buffer, timing and key-frame
+ * asks are the host's picture's; with `set_host_decodes` the engine's own H.264 and AV1 decoders are
+ * stand-ins that produce a placeholder picture, so the host's decoder is the only real one.
+ */
+
+#pragma once
+
+#include <memory>
+
+#include "api/rtp_receiver_interface.h"
+#include "api/scoped_refptr.h"
+#include "livekit/rtp_receiver.h"
+#include "rust/cxx.h"
+
+namespace livekit_ffi {
+class EncodedFrameTap;
+class EncodedFrameSink;
+}  // namespace livekit_ffi
+#include "webrtc-sys/src/encoded_frame_tap.rs.h"
+
+namespace livekit_ffi {
+
+class EncodedFrameTap {
+ public:
+  EncodedFrameTap(webrtc::scoped_refptr<webrtc::RtpReceiverInterface> receiver,
+                  rust::Box<EncodedFrameObserver> observer);
+  ~EncodedFrameTap();
+
+  /// Asks the sender for a key frame (a PLI), for when the host's decoder lost its place.
+  void request_key_frame() const;
+
+ private:
+  webrtc::scoped_refptr<webrtc::RtpReceiverInterface> receiver_;
+  std::unique_ptr<EncodedFrameSink> sink_;
+};
+
+std::shared_ptr<EncodedFrameTap> new_encoded_frame_tap(
+    std::shared_ptr<RtpReceiver> receiver,
+    rust::Box<EncodedFrameObserver> observer);
+
+/// Whether the engine's H.264 and AV1 decoders are stand-ins because the host decodes. Read by the decoder factory.
+bool host_decodes();
+void set_host_decodes(bool on);
+
+}  // namespace livekit_ffi
diff --git a/webrtc-sys/src/encoded_frame_tap.cpp b/webrtc-sys/src/encoded_frame_tap.cpp
new file mode 100644
index 0000000..4583762
--- /dev/null
+++ b/webrtc-sys/src/encoded_frame_tap.cpp
@@ -0,0 +1,95 @@
+/*
+ * See include/livekit/encoded_frame_tap.h. Added by Chatkord (patches/webrtc).
+ */
+
+#include "livekit/encoded_frame_tap.h"
+
+#include <atomic>
+#include <optional>
+#include <utility>
+
+#include "api/video/recordable_encoded_frame.h"
+#include "api/video/video_sink_interface.h"
+#include "api/media_stream_interface.h"
+#include "rtc_base/synchronization/mutex.h"
+
+namespace livekit_ffi {
+
+namespace {
+std::atomic<bool> g_host_decodes{false};
+}  // namespace
+
+bool host_decodes() { return g_host_decodes.load(); }
+void set_host_decodes(bool on) { g_host_decodes.store(on); }
+
+/// Shows the host each frame the receive stream's frame buffer releases, in decode order, whole and with every
+/// frame it references before it. The callback runs on the engine's decode queue under `mutex_`, so it must copy and
+/// return; `detach` clears it under the same lock, so the host never sees a frame after the tap is gone.
+class EncodedFrameSink
+    : public webrtc::VideoSinkInterface<webrtc::RecordableEncodedFrame> {
+ public:
+  explicit EncodedFrameSink(rust::Box<EncodedFrameObserver> observer)
+      : observer_(std::move(observer)) {}
+
+  void OnFrame(const webrtc::RecordableEncodedFrame& frame) override {
+    webrtc::MutexLock lock(&mutex_);
+    if (!observer_) return;
+    auto buffer = frame.encoded_buffer();
+    if (!buffer) return;
+    (*observer_)->on_frame(
+        rust::Slice<const uint8_t>(buffer->data(), buffer->size()),
+        frame.render_time().us(), frame.is_key_frame());
+  }
+
+  /// Stops showing frames to the host and lets its callback be freed.
+  void detach() {
+    webrtc::MutexLock lock(&mutex_);
+    observer_.reset();
+  }
+
+ private:
+  webrtc::Mutex mutex_;
+  std::optional<rust::Box<EncodedFrameObserver>> observer_;
+};
+
+/// The video source of `receiver`'s track, through which encoded frames are asked for; none for sound.
+webrtc::VideoTrackSourceInterface* video_source(
+    const webrtc::scoped_refptr<webrtc::RtpReceiverInterface>& receiver) {
+  auto track = receiver->track();
+  if (!track || track->kind() != webrtc::MediaStreamTrackInterface::kVideoKind) {
+    return nullptr;
+  }
+  return static_cast<webrtc::VideoTrackInterface*>(track.get())->GetSource();
+}
+
+EncodedFrameTap::EncodedFrameTap(
+    webrtc::scoped_refptr<webrtc::RtpReceiverInterface> receiver,
+    rust::Box<EncodedFrameObserver> observer)
+    : receiver_(std::move(receiver)),
+      sink_(std::make_unique<EncodedFrameSink>(std::move(observer))) {
+  if (auto* source = video_source(receiver_)) {
+    source->AddEncodedSink(sink_.get());
+  }
+}
+
+EncodedFrameTap::~EncodedFrameTap() {
+  if (auto* source = video_source(receiver_)) {
+    source->RemoveEncodedSink(sink_.get());
+  }
+  sink_->detach();
+}
+
+void EncodedFrameTap::request_key_frame() const {
+  if (auto* source = video_source(receiver_)) {
+    source->GenerateKeyFrame();
+  }
+}
+
+std::shared_ptr<EncodedFrameTap> new_encoded_frame_tap(
+    std::shared_ptr<RtpReceiver> receiver,
+    rust::Box<EncodedFrameObserver> observer) {
+  return std::make_shared<EncodedFrameTap>(receiver->rtc_receiver(),
+                                           std::move(observer));
+}
+
+}  // namespace livekit_ffi
diff --git a/webrtc-sys/src/encoded_frame_tap.rs b/webrtc-sys/src/encoded_frame_tap.rs
new file mode 100644
index 0000000..bc715b9
--- /dev/null
+++ b/webrtc-sys/src/encoded_frame_tap.rs
@@ -0,0 +1,56 @@
+// Added by Chatkord (patches/webrtc). See include/livekit/encoded_frame_tap.h.
+
+use crate::impl_thread_safety;
+
+/// Called for each video frame the frame buffer releases, on an engine thread. Copy and return.
+pub type OnEncodedFrame = Box<dyn Fn(&[u8], i64, bool) + Send + Sync + 'static>;
+
+#[cxx::bridge(namespace = "livekit_ffi")]
+pub mod ffi {
+    unsafe extern "C++" {
+        include!("livekit/encoded_frame_tap.h");
+        include!("livekit/rtp_receiver.h");
+
+        type RtpReceiver = crate::rtp_receiver::ffi::RtpReceiver;
+
+        /// Shows the host a remote track's encoded frames as the engine's frame buffer releases them.
+        pub type EncodedFrameTap;
+
+        fn request_key_frame(self: &EncodedFrameTap);
+
+        fn new_encoded_frame_tap(
+            receiver: SharedPtr<RtpReceiver>,
+            observer: Box<EncodedFrameObserver>,
+        ) -> SharedPtr<EncodedFrameTap>;
+
+        /// The engine's H.264 and AV1 decoders become stand-ins producing a placeholder picture.
+        fn set_host_decodes(on: bool);
+    }
+
+    extern "Rust" {
+        type EncodedFrameObserver;
+
+        fn on_frame(
+            self: &EncodedFrameObserver,
+            data: &[u8],
+            render_time_us: i64,
+            key_frame: bool,
+        );
+    }
+}
+
+impl_thread_safety!(ffi::EncodedFrameTap, Send + Sync);
+
+pub struct EncodedFrameObserver {
+    observer: OnEncodedFrame,
+}
+
+impl EncodedFrameObserver {
+    pub fn new(observer: OnEncodedFrame) -> Self {
+        Self { observer }
+    }
+
+    fn on_frame(&self, data: &[u8], render_time_us: i64, key_frame: bool) {
+        (self.observer)(data, render_time_us, key_frame);
+    }
+}
