@@ -118,6 +119,12 @@ class AdmProxy : public webrtc::AudioDeviceModule {
   /// Returns true if Platform ADM is currently active (ref_count > 0).
   bool is_platform_adm_active() const;
 
+  // Added by Chatkord (patches/webrtc): how long the host's own speaker takes
+  // to play what the synthetic device hands it, which the engine's audio and
+  // video sync adds to the sound's delay (PlayoutDelay). Lock-free: the host
+  // sets it from its own thread.
+  void set_synthetic_playout_delay(uint16_t delay_ms);
+
   // ===========================================================================
   // Recording/Playout Control
   // ===========================================================================
@@ -281,6 +288,8 @@ class AdmProxy : public webrtc::AudioDeviceModule {
   const webrtc::Environment env_;
   webrtc::Thread* const worker_thread_;
 
+  std::atomic<uint16_t> synthetic_playout_delay_ms_{0};
+
   // All mutable state below is owned by the worker thread.
 
   // Synthetic ADM for synthetic mode - pumps the WebRTC audio pipeline without
diff --git a/webrtc-sys/include/livekit/audio_device_controller.h b/webrtc-sys/include/livekit/audio_device_controller.h
index 1ea994a..c9b0b96 100644
--- a/webrtc-sys/include/livekit/audio_device_controller.h
+++ b/webrtc-sys/include/livekit/audio_device_controller.h
@@ -78,6 +78,8 @@ class AudioDeviceController {
   void release_platform_adm() const;
   int platform_adm_ref_count() const;
   bool is_platform_adm_active() const;
+  // Added by Chatkord (patches/webrtc): see AdmProxy::set_synthetic_playout_delay.
+  void set_playout_delay_ms(uint16_t delay_ms) const;
 
  private:
   // The AdmProxy marshals its calls onto the runtime's worker thread, keep
diff --git a/webrtc-sys/src/adm_proxy.cpp b/webrtc-sys/src/adm_proxy.cpp
index 98d8468..2b4eacf 100644
--- a/webrtc-sys/src/adm_proxy.cpp
+++ b/webrtc-sys/src/adm_proxy.cpp
@@ -822,14 +822,15 @@ int32_t AdmProxy::PlayoutDelay(uint16_t* delayMS) const {
     if (IsPlatformPlayoutActive()) {
       return platform_adm_->PlayoutDelay(delayMS);
     }
-    if (synthetic_adm_) {
-      return synthetic_adm_->PlayoutDelay(delayMS);
-    }
-    *delayMS = 0;
+    *delayMS = synthetic_playout_delay_ms_.load(std::memory_order_relaxed);
     return 0;
   });
 }
 
+void AdmProxy::set_synthetic_playout_delay(uint16_t delay_ms) {
+  synthetic_playout_delay_ms_.store(delay_ms, std::memory_order_relaxed);
+}
+
 bool AdmProxy::BuiltInAECIsAvailable() const {
   return WithPlatformAdm<bool>(false, [](webrtc::AudioDeviceModule& adm) {
     return adm.BuiltInAECIsAvailable();
diff --git a/webrtc-sys/src/audio_device_controller.cpp b/webrtc-sys/src/audio_device_controller.cpp
