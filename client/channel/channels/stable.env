# The stable channel's names, which a build of it goes by everywhere. The Rust build reads this file (channel's
# build.rs) and the packaging scripts source it, so no name is written twice. A value holds no `'`.
CHANNEL_ID=chatkord
CHANNEL_PRODUCT='Chatkord'
CHANNEL_FILE=Chatkord
CHANNEL_APP_USER_MODEL_ID=Chatkord.Chatkord
# Windows' identity of the install: never changed, or a setup no longer replaces the install it should.
CHANNEL_SETUP_ID={4E797837-AE77-42CF-B582-2151AFD51284}
CHANNEL_UPDATE_KEY=release.pub
CHANNEL_FEED=releases/latest/download/
