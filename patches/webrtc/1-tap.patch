diff --git a/libwebrtc/src/native/encoded_frame_tap.rs b/libwebrtc/src/native/encoded_frame_tap.rs
new file mode 100644
index 0000000..d278ace
--- /dev/null
+++ b/libwebrtc/src/native/encoded_frame_tap.rs
@@ -0,0 +1,49 @@
+// Added by Chatkord (patches/webrtc).
+
+//! The encoded video frames of a remote track, shown to the host as the engine's frame buffer releases them.
+//!
+//! The pinned crate decodes a received frame itself and offers no way to read its bytes or to decode
+//! it elsewhere. A tap lets the host see each frame the engine would decode, in decode order and never past
+//! a lost reference, so the engine's feedback, jitter buffer and timing are the host's picture's. [`decode_in_host`] turns the engine's own
+//! H.264 and AV1 decoders into stand-ins, so the host's decoder is the only real one.
+
+use cxx::SharedPtr;
+use webrtc_sys::encoded_frame_tap::{self as sys, ffi as sys_tap};
+
+use crate::rtp_receiver::RtpReceiver;
+
+/// One frame the frame buffer released, borrowed for the length of the callback.
+#[derive(Debug, Clone, Copy)]
+pub struct EncodedFrame<'a> {
+    /// The codec's byte stream for the frame (Annex B for H.264, with the parameter sets a key frame needs; OBUs for AV1).
+    pub data: &'a [u8],
+    /// When the engine's timing says it is shown, in microseconds of its clock.
+    pub render_time_us: i64,
+    pub key_frame: bool,
+}
+
+/// Keeps showing a receiver's frames to the host; dropping it stops the callback.
+pub struct EncodedFrameTap {
+    sys_handle: SharedPtr<sys_tap::EncodedFrameTap>,
+}
+
+impl EncodedFrameTap {
+    /// Calls `on_frame` for every frame the receiver's frame buffer releases, on an engine thread: copy and return.
+    pub fn new(receiver: &RtpReceiver, on_frame: impl Fn(EncodedFrame<'_>) + Send + Sync + 'static) -> Self {
+        let observer = sys::EncodedFrameObserver::new(Box::new(move |data, render_time_us, key_frame| {
+            on_frame(EncodedFrame { data, render_time_us, key_frame });
+        }));
+        Self { sys_handle: sys_tap::new_encoded_frame_tap(receiver.handle.sys_handle.clone(), Box::new(observer)) }
+    }
+
+    /// Asks the sender for a key frame, for when the host's decoder lost its place.
+    pub fn request_key_frame(&self) {
+        self.sys_handle.request_key_frame();
+    }
+}
+
+/// Makes the engine's H.264 and AV1 decoders stand-ins that produce a placeholder picture, for every receiver
+/// created from now on. Without a tap on the receiver nothing would decode its frames.
+pub fn decode_in_host(on: bool) {
+    sys_tap::set_host_decodes(on);
+}
