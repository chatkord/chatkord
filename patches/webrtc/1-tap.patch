 namespace livekit_ffi {
 
+namespace {
+// Chatkord (patches/webrtc): stands in for the engine's H.264 and AV1 decoders when the host decodes the
+// frames the encoded-frame tap hands it, which are the ones the frame buffer gives this decoder. It accepts
+// every frame and answers with a small black picture, so the stream's timing and statistics carry on; a
+// frame lost for good is the frame buffer's to ask a key frame for, a host decoder that failed the host's.
+class StandInDecoder : public webrtc::VideoDecoder {
+ public:
+  bool Configure(const Settings&) override { return true; }
+  int32_t Decode(const webrtc::EncodedImage& input,
+                 bool /* missing_frames */,
+                 int64_t render_time_ms) override {
+    if (!callback_) return WEBRTC_VIDEO_CODEC_UNINITIALIZED;
+    auto buffer = webrtc::I420Buffer::Create(2, 2);
+    webrtc::I420Buffer::SetBlack(buffer.get());
+    webrtc::VideoFrame frame = webrtc::VideoFrame::Builder()
+                                   .set_video_frame_buffer(buffer)
+                                   .set_rtp_timestamp(input.RtpTimestamp())
+                                   .set_timestamp_ms(render_time_ms)
+                                   .build();
+    callback_->Decoded(frame, std::optional<int32_t>(0), std::nullopt);
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t RegisterDecodeCompleteCallback(
+      webrtc::DecodedImageCallback* callback) override {
+    callback_ = callback;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t Release() override { return WEBRTC_VIDEO_CODEC_OK; }
+  DecoderInfo GetDecoderInfo() const override {
+    return {.implementation_name = "host", .is_hardware_accelerated = true};
+  }
+
+ private:
+  webrtc::DecodedImageCallback* callback_ = nullptr;
+};
+}  // namespace
