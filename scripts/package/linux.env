# The Linux package's layout, sourced by scripts/deps/libs.sh and
# scripts/package/linux.sh: one folder holding the binaries and every library they carry, as /opt apps do.
CHATKORD_HOME=/opt/chatkord
# Where our libva looks for a video driver: the package's own first, then the distributions' (va-system-drivers.txt).
# libva stops at the first driver that loads, so a distro's codec-less one must come after ours.
CHATKORD_VA_DRIVERS=$CHATKORD_HOME/dri:$(grep -v '^#' "$(dirname "${BASH_SOURCE[0]}")/va-system-drivers.txt" | paste -sd:)
